<!--
  Deliberately @color/red and not @color/tile_red: the emergency tile owns the tile red, and
  this bar has to read as something other than a tile, since a tile is what it swallows.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/red" />
    <corners android:radius="24dp" />
</shape>
