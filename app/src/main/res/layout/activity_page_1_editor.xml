<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.bald.uriah.baldphone.views.BaldTitleBar
        android:id="@+id/bald_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/color_1"
        app:title="@string/edit_home_screen" />

    <!--
      Nothing down this branch clips its children, so that a tile being carried can be seen
      outside the grid it came from. Every ancestor has to agree: one that still clips cuts
      the tile off at its own edge, however permissive the others are.
    -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:clipChildren="false">

        <!--
          Where a tile is dropped to be got rid of. Hidden until something is being carried:
          a permanent bin invites the question of what it is for, whereas one that appears
          the moment a tile leaves the ground answers it.

          It occupies the clock's place, which is the room there is for it, and the clock
          stands aside while a tile is in the air.

          Declared before the grid, and so drawn beneath it, so that the tile being carried
          passes over the bar rather than behind it. A tile that vanishes behind the thing
          about to swallow it hides exactly what the person needs to see.
        -->
        <LinearLayout
            android:id="@+id/tile_removal_target"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_gravity="top"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_tile_removal"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_close"
                android:tint="@android:color/white" />

            <TextView
                style="@style/ButtonsText.Large"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/remove_tile"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <com.bald.uriah.baldphone.views.home.HomePage1
            android:id="@+id/home_page_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false" />
    </FrameLayout>

    <!--
      Adding and removing tiles happens on its own screen: there are seventeen to choose from
      and no room for them here. It sits under the grid rather than in the title bar because
      it is a second thing to do to the same home screen, not a way out of this one.
    -->
    <include
        android:id="@+id/row_choose_tiles"
        layout="@layout/item_setting"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="10dp" />

</LinearLayout>