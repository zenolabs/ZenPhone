<!--
  The tiles used to be nine views nailed into three rows here, which is why the fourth row had
  to be a special case and why their order could not be changed. They now come from a list, so
  this file only has to say where the grid goes.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/home_screen_padding"
    android:gravity="center_horizontal"
    android:baselineAligned="false"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Clock area, sized to its content so the tiles get the rest of the screen -->
    <include
        layout="@layout/notification_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tiles_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never" />

</LinearLayout>
