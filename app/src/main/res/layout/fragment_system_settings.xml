<!--
  Most of these rows hand off to Android's own settings. They live here rather than in a
  section of their own because that is all they do: the interesting part is that the user
  can reach them without leaving a launcher built to keep things few and large.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include
            android:id="@+id/btn_permissions"
            layout="@layout/item_setting"
            android:layout_width="match_parent"
            android:layout_height="80dp" />

        <include
            android:id="@+id/row_default_launcher"
            layout="@layout/item_setting"
            android:layout_width="match_parent"
            android:layout_height="80dp" />

        <include
            android:id="@+id/row_language"
            layout="@layout/item_setting"
            android:layout_width="match_parent"
            android:layout_height="80dp" />

        <include
            android:id="@+id/row_wifi"
            layout="@layout/item_setting"
            android:layout_width="match_parent"
            android:layout_height="80dp" />

        <include
            android:id="@+id/row_bluetooth"
            layout="@layout/item_setting"
            android:layout_width="match_parent"
            android:layout_height="80dp" />

        <include
            android:id="@+id/row_airplane"
            layout="@layout/item_setting"
            android:layout_width="match_parent"
            android:layout_height="80dp" />

        <include
            android:id="@+id/row_nfc"
            layout="@layout/item_setting"
            android:layout_width="match_parent"
            android:layout_height="80dp" />

        <include
            android:id="@+id/row_location"
            layout="@layout/item_setting"
            android:layout_width="match_parent"
            android:layout_height="80dp" />

        <include
            android:id="@+id/row_android_settings"
            layout="@layout/item_setting"
            android:layout_width="match_parent"
            android:layout_height="80dp" />

    </LinearLayout>
</ScrollView>
