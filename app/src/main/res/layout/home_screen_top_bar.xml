<!--
  Empty on purpose. What goes in the bar is chosen in the settings and filled in by TopBarView,
  so this file only says where the bar is and which way it runs; the landscape copy differs
  from this one in the orientation and nothing else.
-->
<app.baldphone.neo.launcher.topbar.TopBarView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/top_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/home_screen_top_bar_background"
    android:elevation="8dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/home_screen_padding" />
