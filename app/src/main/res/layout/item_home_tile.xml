<!--
  One tile in the home grid. The same FirstPageAppIcon the static rows used, so the inside of
  a tile - icon, label, notification badge - stays exactly as it was; only who decides its
  position has changed. Size is set by the adapter, which divides the grid by the number of
  rows rather than letting each tile claim its natural height.

  The height here is only a starting value, but it must be a definite one. Its content is a
  ConstraintLayout whose icon is a square match-constraint: asked to measure itself against a
  parent of unknown height, that has no single answer and the measure pass does not settle.
-->
<com.bald.uriah.baldphone.views.FirstPageAppIcon
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:layout_margin="4dp"
    android:background="@drawable/bg_tile_green"
    android:foreground="@drawable/fg_home_button"
    android:gravity="center"
    android:padding="@dimen/about_section_padding" />
