<!--
  One choice inside the option chooser. Deliberately as tall as a settings row rather than
  a radio button in a list: the whole strip is the target, and the selection is shown by a
  tick that is large enough to see from arm's length.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@drawable/bg_ripple_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/check"
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:padding="12dp"
        android:src="@drawable/ic_tabler_check"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/label"
        style="@style/ButtonsText.Large"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:paddingEnd="16dp"
        android:paddingStart="0dp"
        tools:text="Only on the home screen" />

</LinearLayout>
