<!--
  A setting that holds one of several values. The current value is shown underneath the
  title rather than only inside the chooser, so the state of the app can be read by
  scrolling the list instead of opening every row in turn.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:background="@drawable/bg_ripple_row"
    android:clickable="true"
    android:focusable="true"
    android:importantForAccessibility="yes"
    android:orientation="horizontal"
    android:padding="4dp">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="80dp"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:padding="12dp"
        android:tint="?attr/bald_text_on_button"
        tools:src="@drawable/ic_tabler_layout_grid" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/title"
            style="@style/ButtonsText.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Status bar" />

        <TextView
            android:id="@+id/subtitle"
            style="@style/ButtonsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Home screen only" />
    </LinearLayout>

    <ImageView
        android:id="@+id/arrow"
        android:layout_width="40dp"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:padding="5dp"
        android:src="@drawable/ic_chevron_right" />

</LinearLayout>
