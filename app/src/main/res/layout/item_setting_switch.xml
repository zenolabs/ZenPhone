<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:background="@drawable/bg_ripple_row"
    android:clickable="true"
    android:focusable="true"
    android:importantForAccessibility="yes"
    android:orientation="horizontal"
    android:padding="4dp">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="80dp"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:padding="12dp"
        android:tint="?attr/bald_text_on_button"
        tools:src="@drawable/ic_tabler_layout_grid" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/title"
            style="@style/ButtonsText.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Fourth row of tiles" />

        <TextView
            android:id="@+id/subtitle"
            style="@style/ButtonsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:visibility="gone"
            tools:text="Medication, apps and alarms"
            tools:visibility="visible" />
    </LinearLayout>

    <!--
      The switch is not focusable on its own: the whole row toggles it. A 96dp target is
      far easier to hit than the switch alone for someone with a tremor, and screen readers
      then announce a single control rather than two.
    -->
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_widget"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginEnd="12dp"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

</LinearLayout>
