<!--
  The insides of NextAlarmView, which is itself the row, hence merge rather than a wrapper.

  The two-bell alarm clock rather than a plain bell: the bell belongs to notifications, where
  every phone this person has owned has put it.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <ImageView
        android:id="@+id/next_alarm_icon"
        android:layout_width="@dimen/clock_secondary_icon_size"
        android:layout_height="@dimen/clock_secondary_icon_size"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_tabler_alarm"
        android:tint="?attr/bald_text_on_background" />

    <TextView
        android:id="@+id/next_alarm_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="sans-serif-medium"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:textColor="?bald_text_on_background"
        android:textSize="@dimen/clock_secondary_text_size"
        tools:text="07:30" />

</merge>
